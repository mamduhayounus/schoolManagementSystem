<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Branch Tree/List View -->
    <record id="view_branch_tree" model="ir.ui.view">
        <field name="name">branch.branch.tree</field>
        <field name="model">branch.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="code"/>
                <field name="name"/>
                <field name="institute_id"/>
                <field name="location"/>
                <field name="contact_number"/>
                <field name="level_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Branch Form View -->
    <record id="view_branch_form" model="ir.ui.view">
        <field name="name">branch.branch.form</field>
        <field name="model">branch.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Branch Name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                            <field name="institute_id" required="1" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="location" required="1"/>
                        </group>
                        <group>
                            <field name="contact_number" required="1"/>
                            <field name="level_ids" required="1" widget="many2many_tags" />
                        </group>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Branch Search View -->
    <record id="view_branch_search" model="ir.ui.view">
        <field name="name">branch.branch.search</field>
        <field name="model">branch.branch</field>
        <field name="arch" type="xml">
            <search string="Search Branches">
                <field name="name"/>
                <field name="institute_id"/>
                <field name="location"/>
                <field name="contact_number"/>

                <group expand="0" string="Group By">
                    <filter
                        string="Institute"
                        name="institute_group"
                        context="{'group_by': 'institute_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">branch.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->


    <menuitem
            id="menu_branch"
            name="Branches"
            parent="menu_configuration"
            action="action_branch"
            groups="school.group_school_admin"/>
</odoo>
