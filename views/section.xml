<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Section Tree/List View -->
    <record id="view_section_tree" model="ir.ui.view">
        <field name="name">section.section.tree</field>
        <field name="model">section.section</field>
        <field name="arch" type="xml">
            <list string="Sections">
                <field name="code"/>
                <field name="name"/>
                <field name="grade_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Section Form View -->
    <record id="view_section_form" model="ir.ui.view">
        <field name="name">section.section.form</field>
        <field name="model">section.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Section Name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="code"/>

                    </group>

                    <notebook>
                        <page string="Grades">
                            <field name="grade_ids">
                                <list editable="bottom">
                                    <field name="name" required="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Students">
                            <field name="student_ids">
                                <list editable="bottom">
                                    <field name="name" required="1"/>
                                    <field name="age"/>
                                    <field name="gender"/>
                                    <field name="cnic"/>
                                    <field name="father_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Section Search View -->
    <record id="view_section_search" model="ir.ui.view">
        <field name="name">section.section.search</field>
        <field name="model">section.section</field>
        <field name="arch" type="xml">
            <search string="Search Sections">
                <field name="name"/>
                <field name="grade_ids"/>

                <group expand="0" string="Group By">
                    <filter
                        string="Grade"
                        name="grade_group"
                        context="{'group_by': 'grade_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Section Action -->
    <record id="action_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">section.section</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Section Menu Item -->

    <menuitem
            id="menu_section"
            name="Sections"
            parent="menu_configuration"
            action="action_section"
            groups="school.group_school_admin"/>
</odoo>
