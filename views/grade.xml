<odoo>
    <!-- Grade Tree/List View -->
    <record id="view_grade_tree" model="ir.ui.view">
        <field name="name">grade.grade.tree</field>
        <field name="model">grade.grade</field>
        <field name="arch" type="xml">
            <list string="Grades">
                <field name="code"/>
                <field name="name"/>
                <field name="level_id"/>
                <field name="section_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Grade Form View -->
    <record id="view_grade_form" model="ir.ui.view">
        <field name="name">grade.grade.form</field>
        <field name="model">grade.grade</field>
        <field name="arch" type="xml">
            <form string="Grade">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Grade Name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="code"/>

                        <field
                                name="level_id"
                                required="1"
                                options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                        <field name="section_ids" required="1" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                    </group>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Grade Search View -->
    <record id="view_grade_search" model="ir.ui.view">
        <field name="name">grade.grade.search</field>
        <field name="model">grade.grade</field>
        <field name="arch" type="xml">
            <search string="Search Grades">
                <field name="name"/>
                <field name="level_id"/>

                <group expand="0" string="Group By">
                    <filter
                        string="Level"
                        name="level_group"
                        context="{'group_by': 'level_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Grade Action -->
    <record id="action_grade" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">grade.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Grade Menu Items -->

    <menuitem
            id="menu_grade"
            name="Grades"
            parent="menu_configuration"
            action="action_grade"
            groups="school.group_school_admin"/>
</odoo>
